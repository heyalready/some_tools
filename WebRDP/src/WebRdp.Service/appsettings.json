{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning"
    }
  },
  "RdpSettings": {
    "DefaultHost": "127.0.0.2",
    "DefaultPort": 3389,
    "MaxSessionCount": 1,
    "SessionTimeout": 3600,
    "ReconnectDelay": 2000,
    "MaxReconnectAttempts": 3
  },
  "PlatformSettings": {
    "Windows": {
      "LocalAddress": "127.0.0.2",
      "SessionType": "local"
    },
    "UOS": {
      "LocalAddress": "127.0.0.2",
      "SessionType": "local"
    }
  },
  "AllowedHosts": "*"
}
